#!/bin/bash
set -e

add_user_and_group() {
	if ! getent group futurehome >/dev/null
	then
		echo "Add group futurehome"
		addgroup --quiet \
			--system \
			futurehome 2>/dev/null || true
	fi

	if ! getent passwd easee >/dev/null
	then
		echo "Add user easee"
		adduser --quiet \
			--system \
			--ingroup futurehome \
			--no-create-home \
			--disabled-password \
			easee 2>/dev/null || true
	fi
}

create_dirs_and_files() {
	echo "Create directories and files"
	touch /var/lib/futurehome/easee/data/config.json
	touch /var/log/futurehome/easee/easee.log
}

migrate() {
	OLD_DIR="/opt/thingsplex/easee/data"

	if [ -L "$OLD_DIR" ]; then
        echo "Error: $OLD_DIR is a symlink, refusing to migrate" >&2
        exit 1
    fi
	
	if [ -d "$OLD_DIR" ]; then
		NEW_DIR="/var/lib/futurehome/easee/data"
		echo "Migrate data from $OLD_DIR to $NEW_DIR"

		if [ ! -d "$NEW_DIR" ]; then
			mkdir -p "$NEW_DIR"
		fi

		chmod 755 "$NEW_DIR"

		# Move contents instead of the directory itself
		if cp -a "$OLD_DIR"/. "$NEW_DIR"/; then
			rm -rf "$OLD_DIR"
		else
			echo "Migration failed, preserving original data" >&2
		fi

		chown -R easee:futurehome "$NEW_DIR"
	fi

	OLD_LOGS="/var/log/thingsplex/easee"

	if [ -L "$OLD_LOGS" ]; then
        echo "Error: $OLD_LOGS is a symlink, refusing to migrate" >&2
        exit 1
    fi

	if [ -d "$OLD_LOGS" ]; then
		NEW_LOGS="/var/log/futurehome/easee"
		echo "Migrate logs from $OLD_LOGS to $NEW_LOGS"

		if [ ! -d "$NEW_LOGS" ]; then
			mkdir -p "$NEW_LOGS"
		fi

		chmod 755 "$NEW_LOGS"
		chown -R easee:futurehome "$NEW_LOGS"

		# Move contents instead of the directory itself
		if cp -a "$OLD_LOGS"/. "$NEW_LOGS"/; then
			rm -rf "$OLD_LOGS"
		else
			echo "Log migration failed, preserving original logs" >&2
		fi

		rm -rf "$OLD_LOGS"
	fi
}

set_ownership() {
  echo "Set ownership and rights for files"
  chown -R easee:futurehome /var/log/futurehome/easee || true
  chown -R easee:futurehome /var/lib/futurehome/easee || true
  
  # Set 755 for directories, 644 for files
  find /var/lib/futurehome/easee -type d -exec chmod 755 {} + || true
  find /var/lib/futurehome/easee -type f -exec chmod 644 {} + || true
  find /var/log/futurehome/easee -type d -exec chmod 755 {} + || true
  find /var/log/futurehome/easee -type f -exec chmod 644 {} + || true
}

configure_service() {
	echo "Configure service"
	systemctl enable easee.service > /dev/null || true
	systemctl --system daemon-reload >/dev/null || true
	systemctl start easee.service > /dev/null || true
}

case "$1" in
	configure)
		add_user_and_group
		migrate
		create_dirs_and_files
		set_ownership
		configure_service
	;;

	abort-upgrade|abort-remove|abort-deconfigure)
	;;

	*)
		echo "postinst called with an unknown argument \`$1'" >&2
		exit 1
	;;
esac

exit 0
