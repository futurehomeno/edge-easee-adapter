#!/bin/sh
set -e

OLD_DATA=/opt/thingsplex/easee
NEW_DATA=/var/lib/futurehome/easee
NEW_LOGS=/var/log/futurehome/easee
MIGRATE=/usr/lib/futurehome/easee/migrate.sh

add_user_and_group() {
	if ! getent group futurehome >/dev/null
	then
		echo "Add group futurehome"
		addgroup --quiet \
			--system \
			futurehome 2>/dev/null || true
	fi

	if ! getent passwd easee >/dev/null
	then
		echo "Add user easee"
		adduser --quiet \
			--system \
			--ingroup futurehome \
			--no-create-home \
			--disabled-password \
			easee 2>/dev/null || true
	fi
}

create_dirs() {
	# The namespace parents, $NEW_DATA itself and the defaults symlink inside
	# it ship in the package (dpkg-owned); install -d re-asserts easee
	# ownership of the leaves on every configure. data/ is created by
	# create_data_dir after migrate_state has run.
	# data/ is world-readable like logs; secrets.json is tightened to 0640 by
	# set_ownership below (storage.NewSecrets enforces 0640 on Save, but not
	# on Load, so a pre-existing file needs an explicit re-chmod too).
	install -d -o easee -g futurehome -m 0755 "$NEW_DATA"
	install -d -o easee -g futurehome -m 0755 "$NEW_LOGS"

	# The defaults symlink sits in an easee-writable directory, and dpkg will
	# not restore it on upgrade if something replaced it with a real
	# directory, so re-assert it on every configure. Safe as root: rm -rf
	# does not follow a planted symlink, and whatever sat at the path was not
	# package content.
	if [ "$(readlink "$NEW_DATA/defaults")" != /usr/share/futurehome/easee/defaults ]; then
		rm -rf "$NEW_DATA/defaults"
		ln -sn /usr/share/futurehome/easee/defaults "$NEW_DATA/defaults"
	fi
}

migrate_state() {
	# Probe for legacy state as root: an unprivileged [ -d ] is silently false
	# when an ancestor directory is untraversable, which would skip the
	# migration instead of failing loudly. migrate.sh may therefore assume the
	# legacy tree exists and treat any read failure as an error. data.db holds
	# the charging sessions at the legacy work dir root, not under data/, and
	# can outlive a data/ that dpkg removed while empty - probe for both. An
	# orphaned legacy log (data removed, log left behind) is deliberately not
	# migrated: the log is history, not state.
	if [ -d "$OLD_DATA/data" ] || [ -f "$OLD_DATA/data.db" ]; then
		fh-drop easee "$MIGRATE"
	fi
}

create_data_dir() {
	# Runs after migrate_state on purpose: migrate.sh triggers on data/ being
	# absent, so creating it up front would silently disable the legacy
	# migration. Fresh installs need it to exist - the service writes
	# data/config.json and data/secrets.json without creating parents.
	install -d -o easee -g futurehome -m 0755 "$NEW_DATA/data"
}

set_ownership() {
	echo "Set ownership and rights for files"
	touch "$NEW_LOGS/easee.log" || true
	# Runs before migrate_state: an interrupted install of an older version
	# can leave root-owned entries under data/ that the unprivileged
	# migration (and its sed on config.json) would trip over on every retry.
	chown -R easee:futurehome "$NEW_DATA" || true
	chown -R easee:futurehome "$NEW_LOGS" || true
	chmod 644 "$NEW_LOGS/easee.log" || true
	# u=rwX,go=rX: world-readable like create_dirs' 0755. secrets.json is not
	# self-protecting here: cliffhanger's storage.Load() never chmods, only
	# Save() does, so this recursive pass would otherwise leave a
	# pre-existing secrets.json (and its .bak) at the directory's
	# world-readable mode until the next credential write. Symlinks
	# (defaults) are left alone by the recursive chmod.
	chmod -R u=rwX,go=rX "$NEW_DATA" || true

	# secrets.json holds the adapter's OAuth tokens and must stay closed to
	# "other" even though data/ is now world-readable. config.json.bak joins
	# it: an upgrade from v2 has not run the credential migration yet, so the
	# config - and the backup cliffhanger renames it to - still carry the
	# tokens inline. Named directly, not via a wildcard, so a symlink planted
	# at one of these paths would be followed by chmod as root; detect and
	# remove any such symlink first.
	for f in "$NEW_DATA/data/secrets.json" "$NEW_DATA/data/secrets.json.bak" \
		"$NEW_DATA/data/config.json.bak"; do
		if [ -L "$f" ]; then
			echo "Warning: $f is a symlink, removing" >&2
			rm -f "$f" || true
		fi
		if [ -e "$f" ]; then
			chmod 0640 "$f" || true
		fi
	done
}

configure_service() {
	echo "Configure service"
	systemctl enable easee.service > /dev/null || true
	systemctl --system daemon-reload >/dev/null || true
	systemctl start easee.service > /dev/null || true
}

case "$1" in
	configure)
		add_user_and_group
		create_dirs
		set_ownership
		migrate_state
		create_data_dir
		configure_service
	;;

	abort-upgrade|abort-remove|abort-deconfigure)
	;;

	*)
		echo "postinst called with an unknown argument \`$1'" >&2
		exit 1
	;;
esac

exit 0
