#!/bin/sh
set -e

# Stop any running instance before the package contents are replaced. Not on
# abort-upgrade: that is the rollback of a failed upgrade, where postinst only
# runs with abort-upgrade and never starts the service again, so stopping here
# would turn a recoverable failure into an outage. install (including reinstall
# over a still-running unit) and upgrade both stop.
if [ "$1" != abort-upgrade ] \
	&& command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  if systemctl is-active --quiet easee.service 2>/dev/null; then
    systemctl stop easee.service || true
  fi
fi

exit 0
