[Unit]
StartLimitIntervalSec=10
StartLimitBurst=5
Description=Futurehome Easee EV charger adapter.

[Service]
Type=simple
ExecStart=/usr/bin/easee -c /var/lib/futurehome/easee
User=easee
WorkingDirectory=/var/lib/futurehome/easee
Restart=always
RestartSec=10
# Surface startup errors via journald - the Go file logger only opens after
# config is loaded, so anything printed before that must go here to be visible.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
