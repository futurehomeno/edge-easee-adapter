[Unit]
StartLimitIntervalSec=10
StartLimitBurst=5
Description=Futurehome Easee EV charger adapter

[Service]
Type=simple
ExecStart=/usr/bin/easee
User=easee
WorkingDirectory=/var/lib/futurehome/easee
Restart=always
RestartSec=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
